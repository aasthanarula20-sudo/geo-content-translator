# Required — get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional — defaults to claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5

# Optional — Phase 1 ships this off by default (see PRD 4.2.1).
# Flip to "true" only once you have paid API access to an AI answer engine to test against.
LIVE_ANSWER_TEST_ENABLED=false
