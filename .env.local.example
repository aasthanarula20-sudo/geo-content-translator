# Set ONE of the two providers below. If both are set, Anthropic (Claude) is used.

# --- Option A: Claude (recommended, production quality) ---
# Get a key at https://console.anthropic.com/ — requires billing set up.
ANTHROPIC_API_KEY=

# Optional — defaults to claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5

# --- Option B: OpenRouter free-tier model (zero cost, for testing only) ---
# Get a key at https://openrouter.ai/settings/keys — no billing required for
# ":free" models. Quality (especially the rewrite) is noticeably lower than
# Claude. The report will show a banner whenever this path is used.
OPENROUTER_API_KEY=

# Optional — override if the default free model below is no longer available.
# Check openrouter.ai/models (filter: "free") for current options.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
